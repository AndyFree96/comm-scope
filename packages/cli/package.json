{
  "name": "comm-scope",
  "version": "0.1.0",
  "description": "Serial / TCP / UDP traffic monitor for developers — CLI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "comm-scope": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "serial",
    "tcp",
    "udp",
    "monitor",
    "traffic",
