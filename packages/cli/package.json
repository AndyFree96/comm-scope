    "sniffer",
    "debug"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndyFree96/comm-scope.git"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthonyfree96/core": "^0.1.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "neo-blessed": "^0.2.0"
  }
}
